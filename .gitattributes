#
# https://help.github.com/articles/dealing-with-line-endings/
#
# Linux start script should use lf. CI runs this on ubuntu, and a CRLF shebang
# there fails with "bad interpreter". The path moved when mod/ became backend/;
# the rule pointed at the old location and had quietly stopped applying.
backend/gradlew text eol=lf

# These are Windows script files and should use crlf
*.bat           text eol=crlf

# Regenerated by Wails on every build, which writes LF. Without this, git on
# Windows (core.autocrlf=true) expects CRLF in the working tree and reports all
# of them as modified after a build - with an empty diff, since the content is
# identical. Declaring them LF makes the expectation match what the generator
# actually writes. The blobs are already LF, so this changes no content.
app/frontend/wailsjs/** text eol=lf
app/go.mod              text eol=lf

